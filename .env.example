AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true

# Connection string Postgres Supabase
# Project Settings → Database → Connection string (URI)
# Pour Netlify / serverless, préférer le pooler (port 6543, mode Transaction)
# Exemple pooler Transaction (recommandé Netlify / Windows IPv4) :
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
